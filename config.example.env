# ClickUp API Configuration
CLICKUP_TOKEN=your_personal_api_token_here

# Team and User IDs (vedi setup.js per come ottenerli)
TEAM_ID=your_team_id_here
USER_ID=your_user_id_here

# Date range (timestamp in milliseconds)
# Esempio per gennaio 2024: START_DATE=1704067200000, END_DATE=1706745599999
START_DATE=1704067200000
END_DATE=1706745599999

# Output options
EXPORT_CSV=true
OUTPUT_DIR=./reports 