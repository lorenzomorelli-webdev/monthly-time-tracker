# ClickUp Multi-Team Time Tracker Configuration
# Copia questo file in .env e modifica con i tuoi dati reali

# 🔑 Il tuo Personal API Token di ClickUp
# Ottienilo da: ClickUp → Settings → Apps → API → Personal API Token
CLICKUP_TOKEN="pk_your_token_here"

# 👤 Il tuo User ID ClickUp
USER_ID="your_user_id"

# 🏢 Team IDs separati da virgola
TEAM_IDS="team_id_1,team_id_2"

# 💰 Tariffa oraria per calcolare i fatturati (opzionale, default: 0)
# Imposta a 0 per disabilitare i calcoli di fatturato
HOURLY_RATE="25"

# 💵 Percentuale netto sul lordo (opzionale, default: 0 = disabilitato)
# Es. 72.48 = trattieni il 72.48% del fatturato lordo come netto
NET_PERCENTAGE="0"

# 📁 Directory dove salvare i report (opzionale, default: ./reports)
OUTPUT_DIR="./reports"

# 💾 Salva report JSON (opzionale, default: true)
SAVE_REPORT="true" 